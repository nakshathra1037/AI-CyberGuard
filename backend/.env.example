# AI-CyberGuard Configuration

# Server
PORT=8000
HOST=0.0.0.0
ENVIRONMENT=development

# Database (Optional - falls back to InMemory if not configured or unavailable)
MONGODB_URI=mongodb://localhost:27017
MONGODB_DATABASE=ai_cyberguard

# AI Investigator (Optional - falls back to deterministic rule-grounded AI if not configured)
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
LLM_BASE_URL=https://api.openai.com/v1

# CORS
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173
